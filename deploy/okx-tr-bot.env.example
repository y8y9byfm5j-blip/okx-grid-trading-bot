# Copy to /etc/okx-tr-bot.env on the VPS (chmod 600). Never commit the real file.

# Same bot token as the existing Telegram bot (BotFather). Only one process
# may poll a token: stop okx-telegram-commands.service before starting this one.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Your chat ID(s), comma separated. Find them with: python3 -m okx_grid.live_bot --kimlik
TELEGRAM_ALLOWED_CHAT_IDS=CHANGE_ME
# Optional: only these Telegram users may give commands (recommended for groups).
TELEGRAM_ALLOWED_USER_IDS=
# Optional: where automatic alerts go (default: first allowed chat).
TELEGRAM_NOTIFY_CHAT_ID=

# paper = test, no OKX orders. live = real OKX TR grid bots (needs the API keys below).
GRID_EXECUTION=paper

# OKX TR API key: permission "Trade" only, NO withdrawal, IP-restricted to this VPS.
OKX_API_KEY=CHANGE_ME
OKX_API_SECRET=CHANGE_ME
OKX_API_PASSPHRASE=CHANGE_ME

# Owner limits (USDT).
GRID_TOTAL_CAPITAL=600
GRID_BOT_CAPITAL=300
GRID_MAX_BOTS=2
# Planned stop-loss per bot. With 3 USDT the grid range must be very narrow (see docs/LIVE_BOT.md).
GRID_RISK_PER_BOT=3
# Automation halts when realized losses reach this amount.
GRID_MAX_REALIZED_LOSS=12
GRID_COOLDOWN_HOURS=6

# Early long scanner: minimum 24h USDT volume of a coin to be scanned.
EARLY_MIN_VOLUME_USDT=1000000
