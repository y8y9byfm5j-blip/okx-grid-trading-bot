#!/usr/bin/env bash
# Phone console without paste: installs the bot, asks only for the short delivery code you chose,
# takes the token and chat ID from the encrypted GitHub hand-over, then finishes in the background:
# bash k/teslim
set -u
cd "$(dirname "$0")" || exit 1
if [ "$(id -u)" -ne 0 ]; then
  echo "root olarak çalıştırın (DigitalOcean konsolunda zaten root'sunuz)."
  exit 1
fi
git pull -q 2>/dev/null || echo "(git pull atlandı)"
bash deploy/install.sh >/root/install.log 2>&1 || { echo "Kod kurulamadı. 'tail -n 20 /root/install.log' yazıp ekran görüntüsünü gönderin."; exit 1; }
PY="$(cat /opt/okx-tr-bot/PYTHON)"
ENV_FILE=/etc/okx-tr-bot.env
"$PY" -m okx_grid.setup_helper teslim "$ENV_FILE" || exit 1
echo "Bilgiler kaydedildi. Kurulum arka planda sürüyor (eski bot kaldırılıyor, yeni bot başlıyor)..."
echo "$(date '+%H:%M:%S') kurulum başlatıldı" > /root/kur.log
setsid nohup bash deploy/kur.sh -y >> /root/kur.log 2>&1 < /dev/null &
echo "Birkaç dakika içinde Telegram'a 'OKX TR bot başladı' mesajı gelecek."
echo "Durumu görmek için: tail -n 15 /root/kur.log"
